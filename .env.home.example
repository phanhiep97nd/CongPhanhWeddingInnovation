# Copy to .env on the home server. Generate each secret with openssl rand -hex 32.
# POSTGRES_PASSWORD must be URL-safe (hex recommended); also used in DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAILS=
BRAND_NAME='Hỷ Thiệp'
OG_GUEST_OVERLAY=on
OG_FONT=Roboto
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_LEGACY_SLUG=hythiep
VITE_BRAND_NAME='Hỷ Thiệp'
